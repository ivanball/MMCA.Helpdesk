<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The scaffold defaults to local-source mode (local.props => UseLocalMMCA=true), so the MMCA.Common.*
    packages resolve from ..\MMCA.Common\Source via ProjectReference and are NOT fetched from a feed.
    Everything else comes from nuget.org.

    To consume MMCA.Common as published NuGet packages instead, just delete local.props. Nothing else
    changes: the MMCA.Common.* packages are published to nuget.org (ADR-053), so the restore needs no
    extra feed, no GitHub personal access token, and no packageSourceCredentials entry.

    The GitHub Packages mirror is only worth adding to restore a version released BEFORE nuget.org
    publishing began (those versions were not backfilled). That registry requires a read:packages token
    even for public packages, which is why it is not the default here. The feed, its MMCA.* source
    mapping, and the audit-source caveat are all in the getting-started guide, Phase 1:
    https://ivanball.github.io/docs/guides/common-GETTING-STARTED.html
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
