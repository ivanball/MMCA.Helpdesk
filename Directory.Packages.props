<!-- For more info on central package management go to https://devblogs.microsoft.com/nuget/introducing-central-package-management/ -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The two engine provider pins. Both package ids carry the engine's name as a substring, and
         scaffolding rewrites exactly that substring (the engineName symbol in
         .template.config/template.json), so the sqlite database option lands on
         AspNetCore.HealthChecks.Sqlite and Microsoft.EntityFrameworkCore.Sqlite at these same
         versions. Keep the ids spelled so the substring stays intact, or the rename stops reaching
         them.
         XML comments cannot carry a double hyphen, so option names are spelled out in prose here. -->
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="MudBlazor" Version="9.9.0" />
    <!-- bUnit v2 (BunitContext / Render API) — xUnit v3 / Microsoft Testing Platform compatible. -->
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.190" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.33.0.1635" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Lockstep with the resolved Microsoft.Testing.Platform (1.9.1, via xunit.v3). -->
    <PackageVersion Include="Microsoft.Testing.Extensions.Retry" Version="1.9.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.13.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <!-- Aspire. Every comment about the orchestration project lives INSIDE its region, so a solution
         generated without one is not handed prose about a project it does not have. -->
    <!-- template:begin aspire -->
    <!-- These three pins belong to the orchestration project alone, which the no-aspire option does
         not generate. Aspire.StackExchange.* and the service-discovery/resilience pins below belong
         to the service hosts and stay in every shape, because AddServiceDefaults() does. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.5.3" />
    <!-- template:end aspire -->
    <!-- template:begin aspireSqlServer -->
    <!-- The one engine-specific orchestration pin: SQLite has no container resource, so the sqlite
         database option needs no hosting integration at all (WithSqliteDataSource only injects a
         connection string). Its own region rather than a nested one: two axes, one line. -->
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.5.3" />
    <!-- template:end aspireSqlServer -->
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.5.3" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <!-- OpenTelemetry.Api pinned directly to force transitive resolution to non-vulnerable version. -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <!-- gRPC -->
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server.Reflection" Version="2.83.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.82.0" />
    <PackageVersion Include="MMCA.Common.Grpc" Version="1.181.0" />
    <!-- MMCA Common Packages -->
    <PackageVersion Include="MMCA.Common.Shared" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.Domain" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.Application" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.Infrastructure" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.API" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.Aspire" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.Aspire.Hosting" Version="1.181.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.9.0" />
    <PackageVersion Include="MMCA.Common.Testing" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.Testing.E2E" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.Testing.UI" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.Testing.Architecture" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.UI" Version="1.181.0" />
    <PackageVersion Include="MMCA.Common.UI.Web" Version="1.181.0" />
  </ItemGroup>
</Project>
