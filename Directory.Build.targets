<Project>
  <!-- Local MMCA development: swap every MMCA.Common.* PackageReference for a ProjectReference into a
       sibling MMCA.Common checkout. Activated by local.props (UseLocalMMCA=true, LocalMMCAPath); see
       local.props.template. The swap list is derived from the Common Source tree, and only packages a
       project references are swapped, which keeps ASP.NET Core out of MAUI and Blazor WASM projects. -->
  <Import Project="$(LocalMMCAPath)..\build\LocalSource\MMCA.Common.LocalSource.targets" Condition="'$(UseLocalMMCA)' == 'true'" />
</Project>
