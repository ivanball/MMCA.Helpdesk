{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Modules": {
    "Tickets": { "Enabled": true }
  },
  "ApplicationSettings": {
    "UseMiniProfiler": false,
    "DatabaseInitStrategy": "Migrate"
  },
  "AuditTrail": {
    "Enabled": true,
    "RetentionDays": 90
  },
  "Scheduler": {
    "Enabled": true,
    "PollingIntervalSeconds": 30,
    "LeaseSeconds": 300
  },
  "Tenancy": {
    "Enabled": true,
    "RequireTenant": false,
    "ResolutionOrder": [ "Claim", "Header" ],
    "ClaimType": "tenant_id",
    "HeaderName": "X-Tenant-Id",
    "Tenants": {
      "acme": {}
    }
  },
  "DataSources": {
    "Tickets": {
      "SqliteConnectionString": "Data Source=helpdesk.db",
      "SqliteMigrationsAssembly": "MMCA.Helpdesk.Migrations.Sqlite.Tickets"
    }
  },
  "ConnectionStrings": {
    "SqliteConnectionString": "Data Source=helpdesk.db"
  }
}
