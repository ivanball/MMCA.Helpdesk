<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>mmca-helpdesk-apphost</UserSecretsId>
  </PropertyGroup>

  <!-- Aspire 17 AppHost: a plain Microsoft.NET.Sdk project. Aspire.Hosting.AppHost brings the
       orchestrator and the AppHost build targets, Aspire.Hosting.Dotnet brings AddDotnetProject. The
       web and ui hosts are declared by path in Program.cs, so there is no ProjectReference to them. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <!-- template:begin sqlserver -->
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <!-- template:end sqlserver -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MMCA.Common.Aspire" />
    <PackageReference Include="MMCA.Common.Aspire.Hosting" />
  </ItemGroup>

</Project>
