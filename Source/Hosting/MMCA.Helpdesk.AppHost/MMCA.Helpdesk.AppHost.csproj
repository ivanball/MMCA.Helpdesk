<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.2" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>mmca-helpdesk-apphost</UserSecretsId>
    <!-- This AppHost runs via dotnet run, not the Aspire CLI bundle; ASPIRE010 nudges toward the
         bundle and is suppressed until that workflow change is adopted deliberately. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hosts\MMCA.Helpdesk.Web\MMCA.Helpdesk.Web.csproj" />
    <ProjectReference Include="..\..\Hosts\UI\MMCA.Helpdesk.UI.Web\MMCA.Helpdesk.UI.Web.csproj" />
    <PackageReference Include="MMCA.Common.Aspire" IsAspireProjectResource="false" />
    <PackageReference Include="MMCA.Common.Aspire.Hosting" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
