<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    @* The framework stylesheet carries the shared accessibility primitives this host relies on: the
       visually-hidden helper behind the live regions, the keyboard focus ring on the page heading,
       and the z-index variable the skip link resolves against. *@
    <link rel="stylesheet" href="_content/MMCA.Common.UI/app.css" />
    @* The scoped-css bundle. Without this link the layout's own .razor.css never reaches the browser,
       which is what styles the skip link. *@
    <link rel="stylesheet" href="MMCA.Helpdesk.UI.Web.styles.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
