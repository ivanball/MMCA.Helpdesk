@using MMCA.Common.UI.Globalization
@using MMCA.Common.UI.Resources
@using MMCA.Common.UI.Theme

@inherits LayoutComponentBase
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@* The four Mud providers (theme, popover, dialog, snackbar) and the ADR-028 dark/light lifecycle are
   owned by the framework's MmcaThemeProviders, so this layout carries only the Helpdesk chrome. *@
<MmcaThemeProviders />

@* WCAG 2.4.1: the first tab stop bypasses the app bar and jumps to the page body. The framework's
   own layout ships the same link, but its styling is scoped to THAT component, so a host with its
   own layout has to carry the rule itself (MainLayout.razor.css beside this file). The text comes
   from the framework's shared resources, so it localizes with the rest of the chrome (ADR-027). *@
<a href="#main-content" class="skip-nav">@L["Layout.SkipToMainContent"]</a>

<MudLayout>
    <MudAppBar Elevation="1">
        @* Decorative: the brand text beside it already names the app, so the icon is hidden from
           assistive technology rather than announced as a second, unlabelled graphic. *@
        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Class="mr-3" aria-hidden="true" />
        @* Typo.h6 is a type SCALE, not an outline level: rendered as h6 the app bar brand became the
           first heading on every page and pushed the real page heading out of order (WCAG 1.3.1). *@
        <MudText Typo="Typo.h6" HtmlTag="span">MMCA.Helpdesk</MudText>
        <MudSpacer />
        <CultureSwitcher />
        <ThemeToggle />
    </MudAppBar>
    <MudMainContent id="main-content">
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
