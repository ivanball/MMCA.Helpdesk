@page "/"
@page "/tickets"
@inject HelpdeskApiClient Api
@inject IToastService Toast
@inject NavigationManager Nav
@inject IAppDialogService Dialog
@inject Microsoft.Extensions.Localization.IStringLocalizer<Tickets> L

<PageHeading Text="@(L["Browser.Tab"].Value)" />

@* HtmlTag, not just the type scale: Routes.razor focuses Selector="h1" on every navigation, and
   Typo.h4 alone renders an h4 that the selector never matches (WCAG 1.3.1 / 2.4.1). *@
<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@L["Heading"]</MudText>

<MudPaper Class="pa-4 mb-6" Elevation="1">
    <SectionHeading>@L["Section.Open"]</SectionHeading>
    <MudGrid>
        <MudItem xs="12" md="4">
            @* Required marks the control required for assistive technology; Error/ErrorText are what
               a rejected submit sets, so the failure lands ON the field instead of only in a toast
               that a screen reader user never gets back to (WCAG 3.3.1). *@
            <MudTextField @ref="_titleField" @bind-Value="_title" Label="@L["Field.Title"].Value" Variant="Variant.Outlined"
                          Required="true" RequiredError="@L["Validation.TitleRequired"].Value"
                          Error="_titleInvalid" ErrorText="@L["Validation.TitleRequired"].Value" />
        </MudItem>
        @* template:begin description *@
        <MudItem xs="12" md="6">
            <MudTextField @ref="_descriptionField" @bind-Value="_description" Label="@L["Field.Description"].Value" Variant="Variant.Outlined"
                          Required="true" RequiredError="@L["Validation.DescriptionRequired"].Value"
                          Error="_descriptionInvalid" ErrorText="@L["Validation.DescriptionRequired"].Value" />
        </MudItem>
        @* template:end description *@
        <MudItem xs="12" md="2" Class="d-flex align-center">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync" Disabled="_busy" FullWidth="true">
                @L["Button.Open"]
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* The table's own state, announced. Loading="_busy" swaps in a progress bar with no text, and the
   row count changes silently after every write, so a polite live region carries both. It is visible
   only to assistive technology: the grid itself is the sighted view of the same fact. *@
<div role="status" aria-live="polite" class="visually-hidden">@TableStatus</div>

@* Hover dropped: the rows are not clickable (the row's own buttons are), so a pointer-only highlight
   promised an interaction that does not exist. MudTable splats unmatched attributes onto its wrapper
   div rather than the table element, and a bare div may not carry aria-label, so role="region" is the
   W3C pattern for a labelled table container. *@
<MudTable Items="_tickets" Loading="_busy" Dense="true" Elevation="1"
          role="region" aria-label="@L["Table.Label"]">
    <HeaderContent>
        <MudTh>@L["Column.Id"]</MudTh>
        <MudTh>@L["Column.Title"]</MudTh>
        @* template:begin status *@
        <MudTh>@L["Column.Status"]</MudTh>
        @* template:end status *@
        @* template:begin owner *@
        <MudTh>@L["Column.Requester"]</MudTh>
        @* template:end owner *@
        <MudTh>@L["Column.Actions"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L["Column.Id"].Value">@context.Id</MudTd>
        <MudTd DataLabel="@L["Column.Title"].Value">@context.Title</MudTd>
        @* template:begin status *@
        @* Enum display localizes via Status.* keys; the wire/enum value itself stays untranslated. *@
        <MudTd DataLabel="@L["Column.Status"].Value">@L[$"Status.{context.Status}"]</MudTd>
        @* template:end status *@
        @* template:begin owner *@
        <MudTd DataLabel="@L["Column.Requester"].Value">@context.RequesterUserId</MudTd>
        @* template:end owner *@
        <MudTd DataLabel="@L["Column.Actions"].Value">
            @* Both controls repeat once per row, so their visible text ("View") and their icon alone
               name nothing in a list of links or buttons. The aria-label adds the row's identity
               (WCAG 2.4.4 / 4.1.2) while the visible text stays short. *@
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                       OnClick="@(() => Nav.NavigateTo($"/tickets/{context.Id}"))"
                       aria-label="@L["Aria.View", context.Id]">
                @L["Button.View"]
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => DeleteAsync(context.Id))" Disabled="_busy"
                           aria-label="@L["Aria.Delete", context.Id]" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>@L["Empty.Message"]</MudText>
    </NoRecordsContent>
</MudTable>

@* The list pages by cursor, newest first: each "load more" asks for the page after the last one
   loaded, so a ticket added meanwhile never shifts a row onto the next page twice. The button is
   there only while the server says more remain. *@
@if (_nextCursor is not null)
{
    <div class="d-flex justify-center mt-4">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadMoreAsync" Disabled="_busy">
            @L["Button.LoadMore"]
        </MudButton>
    </div>
}

@code {
    // One page of the list per request; "load more" appends the next one.
    private const int PageSize = 20;

    private readonly List<TicketDTO> _tickets = [];
    private string? _nextCursor;
    private string _title = string.Empty;
    @* template:begin description *@
    private string _description = string.Empty;
    @* template:end description *@
    private bool _busy;

    // Validation state per field, so a rejected submit can mark the control invalid and put focus on
    // it rather than only raising a toast (WCAG 3.3.1 / 3.3.3).
    private MudTextField<string>? _titleField;
    private bool _titleInvalid;

    @* template:begin description *@
    private MudTextField<string>? _descriptionField;
    private bool _descriptionInvalid;

    @* template:end description *@
    // Text for the table's live region: what the grid is doing, in words, for a reader that cannot
    // see either the progress bar or the rows.
    private string TableStatus => _busy
        ? L["Live.Loading"].Value
        : L["Live.RowCount", _tickets.Count].Value;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Reloads from the first page: after a write the rows already shown may have changed.
    private async Task LoadAsync() => await LoadPageAsync(cursor: null);

    private async Task LoadMoreAsync() => await LoadPageAsync(_nextCursor);

    private async Task LoadPageAsync(string? cursor)
    {
        _busy = true;
        try
        {
            // The client returns a result rather than throwing, so the page branches instead of
            // catching: TryGetValue unwraps the success, LocalizedErrorMessage composes the failure
            // (ProblemDetails errors, most severe first) through this page's own localizer.
            var result = await Api.GetTicketPageAsync(cursor, PageSize);
            if (result.TryGetValue(out var page))
            {
                if (cursor is null)
                {
                    _tickets.Clear();
                }

                if (page.Items is { } items)
                {
                    _tickets.AddRange(items);
                }

                _nextCursor = page.NextCursor;
            }
            else
            {
                Toast.Error(L["Snackbar.LoadFailed", result.LocalizedErrorMessage(L) ?? string.Empty]);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        var confirmed = await Dialog.ConfirmAsync(
            L["Dialog.Delete.Heading"],
            L["Dialog.Delete.Message", id],
            L["Dialog.Delete.Confirm"],
            L["Dialog.Cancel"]);
        if (!confirmed)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.DeleteTicketAsync(id);
            if (result.IsSuccess)
            {
                Toast.Success(L["Snackbar.Deleted"]);
                await LoadAsync();
            }
            else
            {
                Toast.Error(L["Snackbar.DeleteFailed", result.LocalizedErrorMessage(L) ?? string.Empty]);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateAsync()
    {
        // One accumulator per field rather than one boolean expression: each optional field of the
        // scaffold then occupies its own line, which is what lets a shape drop it whole.
        _titleInvalid = string.IsNullOrWhiteSpace(_title);
        @* template:begin description *@
        _descriptionInvalid = string.IsNullOrWhiteSpace(_description);
        @* template:end description *@
        bool missingRequired = _titleInvalid;
        @* template:begin description *@
        missingRequired = missingRequired || _descriptionInvalid;
        @* template:end description *@
        if (missingRequired)
        {
            // The toast alone is a WCAG 3.3.1 gap: it says something is wrong, never which control,
            // and it is gone before a reader reaches it. The per-field flags above put the message on
            // the offending control; this puts the caret there too.
            Toast.Warning(L["Snackbar.RequiredFields"]);
            await FocusFirstInvalidAsync();
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.CreateTicketAsync(_title, _description, requesterUserId: 1);
            if (result.IsSuccess)
            {
                Toast.Success(L["Snackbar.Opened"]);
                _title = string.Empty;
                @* template:begin description *@
                _description = string.Empty;
                @* template:end description *@
                await LoadAsync();
            }
            else
            {
                Toast.Error(L["Snackbar.OpenFailed", result.LocalizedErrorMessage(L) ?? string.Empty]);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // First invalid control wins, in visual order, which is what a sighted user would reach first too.
    private async Task FocusFirstInvalidAsync()
    {
        if (_titleInvalid && _titleField is not null)
        {
            await _titleField.FocusAsync();
            return;
        }
        @* template:begin description *@

        if (_descriptionInvalid && _descriptionField is not null)
        {
            await _descriptionField.FocusAsync();
        }
        @* template:end description *@
    }
}
