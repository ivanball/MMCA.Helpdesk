@page "/tickets/{Id:int}"
@inject HelpdeskApiClient Api
@inject IToastService Toast
@inject NavigationManager Nav
@inject IAppDialogService Dialog
@inject Microsoft.Extensions.Localization.IStringLocalizer<TicketDetail> L

<PageHeading Text="@(L["Browser.Tab", Id].Value)" />

<MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" Class="mb-4">@L["Button.Back"]</MudButton>
<MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="DeleteAsync" Disabled="_busy" Class="mb-4 ml-2">
    @L["Button.Delete"]
</MudButton>

@if (_ticket is null)
{
    @* The framework's loading placeholder is a role="status" live region, so the wait is announced
       rather than rendered as a silent line of text. *@
    <PageLoadingState Label="@L["Loading", Id].Value" />
}
else
{
    @* HtmlTag, not just the type scale: Routes.razor focuses Selector="h1" on every navigation, and
       Typo.h4 alone renders an h4 that the selector never matches (WCAG 1.3.1 / 2.4.1). *@
    <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@L["Heading", _ticket.Id]</MudText>

    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <SectionHeading>@L["Section.Details"]</SectionHeading>
        @* Required marks the control required for assistive technology; Error/ErrorText are what a
           rejected save sets, so the failure lands ON the field instead of only in a toast that a
           screen reader user never gets back to (WCAG 3.3.1). *@
        <MudTextField @ref="_titleField" @bind-Value="_title" Label="@L["Field.Title"].Value" Variant="Variant.Outlined" Class="mb-3"
                      Required="true" RequiredError="@L["Validation.TitleRequired"].Value"
                      Error="_titleInvalid" ErrorText="@L["Validation.TitleRequired"].Value" />
        @* template:begin description *@
        <MudTextField @ref="_descriptionField" @bind-Value="_description" Label="@L["Field.Description"].Value" Variant="Variant.Outlined" Lines="3" Class="mb-3"
                      Required="true" RequiredError="@L["Validation.DescriptionRequired"].Value"
                      Error="_descriptionInvalid" ErrorText="@L["Validation.DescriptionRequired"].Value" />
        @* template:end description *@
        @* template:begin statusOrOwner *@
        @* A save changes this line without moving focus, so it is a polite live region: the new value
           is announced instead of only repainting. *@
        <MudText Typo="Typo.body2" Class="mb-3" role="status" aria-live="polite">
            @* template:begin status *@
            @* Enum display localizes via Status.* keys; the wire/enum value itself stays untranslated. *@
            @L["Detail.Status"] <b>@L[$"Status.{_ticket.Status}"]</b>
            @* template:end status *@
            @* template:begin statusOwner *@
            &nbsp;&middot;&nbsp;
            @* template:end statusOwner *@
            @* template:begin owner *@
            @L["Detail.Requester"] <b>@_ticket.RequesterUserId</b>
            @* template:end owner *@
        </MudText>
        @* template:end statusOrOwner *@
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveDetailsAsync" Disabled="_busy">
            @L["Button.SaveDetails"]
        </MudButton>
    </MudPaper>

    @* template:begin status *@
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <SectionHeading>@L["Section.Status"]</SectionHeading>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="TicketStatus" @bind-Value="_status" Label="@L["Field.Status"].Value" Variant="Variant.Outlined">
                    @foreach (var status in Enum.GetValues<TicketStatus>())
                    {
                        <MudSelectItem Value="status">@L[$"Status.{status}"]</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center">
                <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="ChangeStatusAsync" Disabled="_busy">
                    @L["Button.ChangeStatus"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
    @* template:end status *@

    @* template:begin child *@
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <SectionHeading>@L["Section.AddComment"]</SectionHeading>
        <MudGrid>
            <MudItem xs="12" md="10">
                <MudTextField @ref="_newCommentField" @bind-Value="_newComment" Label="@L["Field.Comment"].Value" Variant="Variant.Outlined"
                              Required="true" RequiredError="@L["Validation.CommentRequired"].Value"
                              Error="_newCommentInvalid" ErrorText="@L["Validation.CommentRequired"].Value" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddCommentAsync" Disabled="_busy" FullWidth="true">
                    @L["Button.AddComment"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <SectionHeading>@L["Section.Comments"]</SectionHeading>
    @if (_ticket.Comments.Count == 0)
    {
        <MudText>@L["Empty.Comments"]</MudText>
    }
    else
    {
        @* A real list, not a run of sibling cards: the list role is what tells a reader how many
           children there are and which one it is on (WCAG 1.3.1). The bullet is dropped because
           the card inside supplies the visual separation. *@
        <ul class="pa-0 ma-0" style="list-style: none;" aria-label="@L["Aria.CommentList"]">
            @foreach (var comment in _ticket.Comments)
            {
                <li>
                    <MudPaper Class="pa-3 mb-2" Outlined="true">
                        @if (_editingCommentId == comment.Id)
                        {
                            <MudTextField @ref="_editCommentField" @bind-Value="_editCommentBody" Label="@L["Field.Comment"].Value"
                                          Variant="Variant.Outlined" Class="mb-2"
                                          Required="true" RequiredError="@L["Validation.CommentRequired"].Value"
                                          Error="_editCommentInvalid" ErrorText="@L["Validation.CommentRequired"].Value" />
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                       OnClick="@(() => SaveCommentAsync(comment.Id))" Disabled="_busy">
                                @L["Button.SaveComment"]
                            </MudButton>
                            <MudButton Size="Size.Small" OnClick="CancelEdit">@L["Button.CancelEdit"]</MudButton>
                        }
                        else
                        {
                            <div class="d-flex align-center justify-space-between">
                                <div>
                                    <MudText>@comment.Body</MudText>
                                    <MudText Typo="Typo.caption">@L["Comment.By", comment.AuthorUserId]</MudText>
                                </div>
                                <div>
                                    @* Icon-only buttons repeated once per child name nothing on their
                                       own, and the ref is what lets leaving the editor put focus back
                                       on the button that opened it (WCAG 2.4.3 / 4.1.2). *@
                                    <MudIconButton @ref="_editButtons[comment.Id]" Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   OnClick="@(() => BeginEdit(comment))" Disabled="_busy"
                                                   aria-label="@L["Aria.EditComment", comment.Id]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => RemoveCommentAsync(comment.Id))" Disabled="_busy"
                                                   aria-label="@L["Aria.DeleteComment", comment.Id]" />
                                </div>
                            </div>
                        }
                    </MudPaper>
                </li>
            }
        </ul>
    }
    @* template:end child *@
}

@code {
    [Parameter] public int Id { get; set; }

    private TicketDTO? _ticket;
    private string _title = string.Empty;
    @* template:begin description *@
    private string _description = string.Empty;
    @* template:end description *@
    @* template:begin status *@
    private TicketStatus _status;
    @* template:end status *@
    @* template:begin child *@
    private string _newComment = string.Empty;
    private string _editCommentBody = string.Empty;
    private int? _editingCommentId;
    @* template:end child *@
    private bool _busy;

    // Validation state per field, so a rejected save can mark the control invalid and put focus on
    // it rather than only raising a toast (WCAG 3.3.1 / 3.3.3).
    private MudTextField<string>? _titleField;
    private bool _titleInvalid;

    @* template:begin description *@
    private MudTextField<string>? _descriptionField;
    private bool _descriptionInvalid;

    @* template:end description *@
    @* template:begin child *@
    // Focus management for the inline editor. Opening it moves focus into the field; leaving it hands
    // focus back to the button that opened it, which is the one a keyboard user was standing on
    // (WCAG 2.4.3). The dictionary is keyed by child id because the buttons come from a loop.
    private readonly Dictionary<int, MudIconButton> _editButtons = [];
    private MudTextField<string>? _newCommentField;
    private bool _newCommentInvalid;
    private MudTextField<string>? _editCommentField;
    private bool _editCommentInvalid;
    private bool _focusEditor;
    private int? _restoreFocusTo;

    @* template:end child *@
    protected override async Task OnParametersSetAsync() => await LoadAsync();

    @* template:begin child *@
    // Focus has to move AFTER the render that creates (or removes) the editor, which is what this
    // override is for. Both flags are one-shot: they are cleared as they are honored.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusEditor && _editCommentField is not null)
        {
            _focusEditor = false;
            await _editCommentField.FocusAsync();
        }

        if (_restoreFocusTo is int restoreId && _editButtons.TryGetValue(restoreId, out var button))
        {
            _restoreFocusTo = null;
            await button.FocusAsync();
        }
    }

    @* template:end child *@
    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            // A missing ticket is a NotFound failure now, not a null value, so the one branch below
            // covers both "gone" and "the call failed": TryGetValue unwraps the success and
            // LocalizedErrorMessage composes whatever the API's ProblemDetails body reported.
            var result = await Api.GetTicketAsync(Id);
            if (result.TryGetValue(out var ticket))
            {
                _ticket = ticket;
                _title = ticket.Title;
                @* template:begin description *@
                _description = ticket.Description;
                @* template:end description *@
                @* template:begin status *@
                _status = ticket.Status;
                @* template:end status *@
            }
            else
            {
                Toast.Error(L["Snackbar.LoadFailed", result.LocalizedErrorMessage(L) ?? string.Empty]);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveDetailsAsync()
    {
        // The write is conditional on the version this page loaded (ADR-035), so it needs the ticket
        // in hand. The button only renders once it is there; the local makes that fact explicit.
        var ticket = _ticket;
        if (ticket is null)
        {
            return;
        }

        // One accumulator per field rather than one boolean expression: each optional field of the
        // scaffold then occupies its own line, which is what lets a shape drop it whole.
        _titleInvalid = string.IsNullOrWhiteSpace(_title);
        @* template:begin description *@
        _descriptionInvalid = string.IsNullOrWhiteSpace(_description);
        @* template:end description *@
        bool missingRequired = _titleInvalid;
        @* template:begin description *@
        missingRequired = missingRequired || _descriptionInvalid;
        @* template:end description *@
        if (missingRequired)
        {
            // The toast alone is a WCAG 3.3.1 gap: it says something is wrong, never which control,
            // and it is gone before a reader reaches it. The per-field flags above put the message on
            // the offending control; this puts the caret there too.
            Toast.Warning(L["Snackbar.RequiredFields"]);
            await FocusFirstInvalidAsync();
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.UpdateTicketAsync(Id, _title, _description, ticket.RowVersion);
            if (result.IsSuccess)
            {
                Toast.Success(L["Snackbar.Updated"]);
                await LoadAsync();
            }
            else
            {
                Toast.Error(L["Snackbar.UpdateFailed", result.LocalizedErrorMessage(L) ?? string.Empty]);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    @* template:begin status *@
    private async Task ChangeStatusAsync()
    {
        var ticket = _ticket;
        if (ticket is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.ChangeStatusAsync(Id, _status, ticket.RowVersion);
            if (result.IsSuccess)
            {
                Toast.Success(L["Snackbar.StatusUpdated"]);
                await LoadAsync();
            }
            else
            {
                Toast.Error(L["Snackbar.StatusChangeFailed", result.LocalizedErrorMessage(L) ?? string.Empty]);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    @* template:end status *@
    @* template:begin child *@
    private async Task AddCommentAsync()
    {
        _newCommentInvalid = string.IsNullOrWhiteSpace(_newComment);
        if (_newCommentInvalid)
        {
            Toast.Warning(L["Snackbar.CommentEmpty"]);
            if (_newCommentField is not null)
            {
                await _newCommentField.FocusAsync();
            }

            return;
        }

        _busy = true;
        try
        {
            var result = await Api.AddCommentAsync(Id, _newComment, authorUserId: 1);
            if (result.IsSuccess)
            {
                _newComment = string.Empty;
                await LoadAsync();
            }
            else
            {
                Toast.Error(L["Snackbar.AddCommentFailed", result.LocalizedErrorMessage(L) ?? string.Empty]);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void BeginEdit(TicketCommentDTO comment)
    {
        _editingCommentId = comment.Id;
        _editCommentBody = comment.Body;
        _editCommentInvalid = false;
        // The editor does not exist yet; OnAfterRenderAsync focuses it once this render creates it.
        _focusEditor = true;
    }

    private void CancelEdit()
    {
        // Leaving the editor destroys the control focus was on, so focus is handed back to the button
        // that opened it rather than being dropped onto the document body.
        _restoreFocusTo = _editingCommentId;
        _editingCommentId = null;
        _editCommentBody = string.Empty;
        _editCommentInvalid = false;
    }

    private async Task SaveCommentAsync(int commentId)
    {
        // The precondition is the OWNING ticket's version: concurrency is stamped on the aggregate
        // root, which is what the ticket read returned.
        var ticket = _ticket;
        if (ticket is null)
        {
            return;
        }

        _editCommentInvalid = string.IsNullOrWhiteSpace(_editCommentBody);
        if (_editCommentInvalid)
        {
            Toast.Warning(L["Snackbar.CommentEmpty"]);
            if (_editCommentField is not null)
            {
                await _editCommentField.FocusAsync();
            }

            return;
        }

        _busy = true;
        try
        {
            var result = await Api.EditCommentAsync(Id, commentId, _editCommentBody, ticket.RowVersion);
            if (result.IsSuccess)
            {
                _restoreFocusTo = commentId;
                _editingCommentId = null;
                await LoadAsync();
            }
            else
            {
                Toast.Error(L["Snackbar.EditFailed", result.LocalizedErrorMessage(L) ?? string.Empty]);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveCommentAsync(int commentId)
    {
        _busy = true;
        try
        {
            var result = await Api.RemoveCommentAsync(Id, commentId);
            if (result.IsSuccess)
            {
                await LoadAsync();
            }
            else
            {
                Toast.Error(L["Snackbar.RemoveFailed", result.LocalizedErrorMessage(L) ?? string.Empty]);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    @* template:end child *@
    private async Task DeleteAsync()
    {
        var confirmed = await Dialog.ConfirmAsync(
            L["Dialog.Delete.Heading"],
            L["Dialog.Delete.Message", Id],
            L["Dialog.Delete.Confirm"],
            L["Dialog.Cancel"]);
        if (!confirmed)
        {
            return;
        }

        _busy = true;
        var result = await Api.DeleteTicketAsync(Id);
        if (result.IsSuccess)
        {
            Toast.Success(L["Snackbar.Deleted"]);
            // Deliberately leaves _busy set: the page is navigating away, so re-enabling the buttons
            // would only flicker them back on for the frame before the route changes.
            Nav.NavigateTo("/tickets");
        }
        else
        {
            Toast.Error(L["Snackbar.DeleteFailed", result.LocalizedErrorMessage(L) ?? string.Empty]);
            _busy = false;
        }
    }

    // First invalid control wins, in visual order, which is what a sighted user would reach first too.
    private async Task FocusFirstInvalidAsync()
    {
        if (_titleInvalid && _titleField is not null)
        {
            await _titleField.FocusAsync();
            return;
        }
        @* template:begin description *@

        if (_descriptionInvalid && _descriptionField is not null)
        {
            await _descriptionField.FocusAsync();
        }
        @* template:end description *@
    }

    private void GoBack() => Nav.NavigateTo("/tickets");
}
